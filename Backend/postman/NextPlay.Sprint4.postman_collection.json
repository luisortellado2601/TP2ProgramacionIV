                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro admin -> 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);",
                  "pm.collectionVariables.set('adminId', pm.response.json().usuario.id);",
                  "pm.test('El perfil es administrador', () => pm.expect(pm.response.json().usuario.perfil).to.eql('administrador'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
