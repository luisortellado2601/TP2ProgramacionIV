        {
          "name": "13. Token vencido (solo con token de vida corta)",
          "description": "Registra un usuario nuevo y espera hasta que venza su token (lee el \"exp\"). Solo espera si faltan 120 s o menos: con JWT_EXPIRES_IN_SEGUNDOS = 900 (produccion) el vencimiento se omite. Para probarlo, poner un valor bajo (30) en Backend/.env, reiniciar el back y correr este request. Verifica que autorizar, refrescar y una ruta protegida respondan 401 con el token vencido.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const L = eval('(' + pm.variables.get('lib') + ')')(pm);",
                  "const MAXIMO_ESPERA_S = 120;",
                  "pm.collectionVariables.set('vencidoOmitido', 'true');",
                  "pm.sendRequest({",
                  "  url: pm.variables.get('baseUrl') + '/auth/registro', method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify(L.cuerpoRegistro('vera')) },",
                  "}, (err, res) => {",
                  "  const token = res.json().token;",
                  "  pm.collectionVariables.set('tokenVencible', token);",
                  "  const faltanMs = L.decodificar(token).exp * 1000 - Date.now() + 1500;",
                  "  if (faltanMs / 1000 <= MAXIMO_ESPERA_S) {",
                  "    pm.collectionVariables.set('vencidoOmitido', 'false');",
                  "    setTimeout(() => {}, Math.max(faltanMs, 0));",
                  "  }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const L = eval('(' + pm.variables.get('lib') + ')')(pm);",
                  "(async () => {",
                  "if (pm.collectionVariables.get('vencidoOmitido') === 'true') {",
                  "  pm.test.skip('Omitido: el token dura mas de 120 s (bajar JWT_EXPIRES_IN_SEGUNDOS para probar el vencimiento)');",
                  "  return;",
                  "}",
                  "pm.test('Autorizar con token vencido -> 401 \"vencido\"', () => {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().message).to.include('vencido');",
                  "});",
                  "const vencido = pm.collectionVariables.get('tokenVencible');",
                  "await L.probar('Refrescar con token vencido (ya no se puede renovar)', 401, { metodo: 'POST', ruta: '/auth/refrescar', token: vencido });",
                  "await L.probar('Ruta protegida con token vencido', 401, { ruta: '/publicaciones', token: vencido });",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/autorizar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
