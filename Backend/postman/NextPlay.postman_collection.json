    {
      "name": "Publicaciones",
      "description": "Correr esta carpeta de arriba a abajo (botón Run). Los primeros dos requests crean usuarios de prueba y guardan sus ids en variables de colección (autorId, otroUsuarioId) que usan el resto de los requests. Como todavía no hay JwtAuthGuard (llega en el Sprint #3), el usuario que actúa viaja como `usuarioId` en el body o como query param.",
      "item": [
        {
          "name": "Setup - Registrar autor (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('autorId', body.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Gomez\",\n  \"correo\": \"ana.{{$timestamp}}@example.com\",\n  \"nombreUsuario\": \"ana{{$timestamp}}\",\n  \"contrasena\": \"Password1\",\n  \"repetirContrasena\": \"Password1\",\n  \"fechaNacimiento\": \"2000-01-01\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/auth/registro",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["auth", "registro"]
            }
          },
          "response": []
        },
