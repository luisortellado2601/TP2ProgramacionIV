                  "await L.probar('Detalle de una publicacion eliminada', 404, { ruta: ruta, token: L.autor() });",
                  "await L.probar('Comentar en una publicacion eliminada', 404, { metodo: 'POST', ruta: ruta + '/comentarios', token: L.autor(), body: { mensaje: 'hola' } });",
                  "await L.probar('Listar comentarios de una publicacion eliminada', 404, { ruta: ruta + '/comentarios', token: L.autor() });",
                  "await L.probar('Editar un comentario de una publicacion eliminada', 404, {",
